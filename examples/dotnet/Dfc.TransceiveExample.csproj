<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DfcNativeDirectory Condition="'$(DfcNativeDirectory)' == ''">$(MSBuildThisFileDirectory)../../build</DfcNativeDirectory>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../bindings/dotnet/src/Dfc/Dfc.csproj" />
  </ItemGroup>

  <!-- A development build is copied beside the app, matching packaged runtime assets. -->
  <ItemGroup>
    <DfcNative Include="$(DfcNativeDirectory)/libdfc.dylib" Condition="Exists('$(DfcNativeDirectory)/libdfc.dylib')" />
    <DfcNative Include="$(DfcNativeDirectory)/libdfc.so" Condition="Exists('$(DfcNativeDirectory)/libdfc.so')" />
    <DfcNative Include="$(DfcNativeDirectory)/libdfc.dll" Condition="Exists('$(DfcNativeDirectory)/libdfc.dll')" />
    <DfcNative Include="$(DfcNativeDirectory)/Release/libdfc.dll" Condition="Exists('$(DfcNativeDirectory)/Release/libdfc.dll')" />
    <None Include="@(DfcNative)" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
