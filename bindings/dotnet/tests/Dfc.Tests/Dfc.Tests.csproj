<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Dfc\Dfc.csproj" />
  </ItemGroup>

  <!-- The native library from the CMake build, next to the test assembly. -->
  <ItemGroup>
    <DfcNative Include="$(DfcNativeDirectory)/libdfc.dylib" Condition="Exists('$(DfcNativeDirectory)/libdfc.dylib')" />
    <DfcNative Include="$(DfcNativeDirectory)/libdfc.so" Condition="Exists('$(DfcNativeDirectory)/libdfc.so')" />
    <DfcNative Include="$(DfcNativeDirectory)/dfc.dll" Condition="Exists('$(DfcNativeDirectory)/dfc.dll')" />
    <DfcNative Include="$(DfcNativeDirectory)/Release/dfc.dll" Condition="Exists('$(DfcNativeDirectory)/Release/dfc.dll')" />
    <None Include="@(DfcNative)" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
