<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="NUnit" Version="5.0.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Dfc\Dfc.csproj" />
    <None Include="..\..\..\..\tests\command-constructor-vectors.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\..\tests\iso7816-helper-vectors.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\..\tests\command-constructor-boundaries.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\..\tests\authentication-boundaries.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\..\tests\replay-plans\*.plan" CopyToOutputDirectory="PreserveNewest" Link="replay-plans\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The native library from the CMake build, next to the test assembly. -->
  <ItemGroup>
    <DfcNative Include="$(DfcNativeDirectory)/libdfc.dylib" Condition="Exists('$(DfcNativeDirectory)/libdfc.dylib')" />
    <DfcNative Include="$(DfcNativeDirectory)/libdfc.so" Condition="Exists('$(DfcNativeDirectory)/libdfc.so')" />
    <DfcNative Include="$(DfcNativeDirectory)/libdfc.dll" Condition="Exists('$(DfcNativeDirectory)/libdfc.dll')" />
    <DfcNative Include="$(DfcNativeDirectory)/Release/libdfc.dll" Condition="Exists('$(DfcNativeDirectory)/Release/libdfc.dll')" />
    <None Include="@(DfcNative)" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
