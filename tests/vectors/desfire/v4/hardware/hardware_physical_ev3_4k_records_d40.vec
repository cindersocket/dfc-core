# Authenticate as key 1.
inject-random 93A220284065DC6A
exchange native-apdu 900A0000010100 => 4FB7149CA3E9495091AF
exchange native-apdu 90AF00001005EEC31F1E6A0CC3C2DA389E4BFE0A8400 => 26ACED3C771EF9A09100
#
