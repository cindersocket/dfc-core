# A ChangeKey whose cryptogram has been flipped fails the CRC check, answers
# 0x1E and leaves the stored key untouched.
#
# Generated from tests/test_dfc_virtual_picc_mutation_vectors.c
# (/aes-change-key-integrity-error-preserves-key) by recording the exchanges the
# reference engine performed, then cross-checked: all 3 byte
# expectations asserted by that test matched the recording exactly.
# 1 further exchanges carry no byte expectation in the source.
#
# The ChangeKey cryptograms are computed at runtime by the original test
# from the derived session key, so they are recorded rather than
# transcribed. inject-random pins RndB ahead of every authentication so
# the vector does not depend on the engine's default generator.
#
# The original pre-creates AID 112233 (0F / AES, one key) directly on the
# credential; the vector creates the same application over the wire, which is
# the only way a corpus vector can set it up. The final assert is the
# key-preservation check the original makes on credential.apps[0].

name: AES ChangeKey with a tampered cryptogram
origin: synthetic
requires: auth-aes
source: tests/test_dfc_virtual_picc_mutation_vectors.c#/aes-change-key-integrity-error-preserves-key
issues: https://github.com/cindersocket/dfc-core/issues/11, https://github.com/cindersocket/dfc-core/issues/13
uid: 04334455667788
picc-key-settings-1: 0F
picc-key-settings-2: 81
picc-auth-mode: AES
picc-key-len: 16

scan
status   90CA0000051122330F8100 => 00
status   905A00000311223300 => 00
inject-random 000102030405060708090A0B0C0D0E0F
exchange native-apdu 90AA0000010000 => 7ACA0FD9BCD6EC7C9F97466616E6A28291AF
exchange native-apdu 90AF000020ECC9B00FDB4E6B30E0A7FCF1C08A892CA8F292369D4982D894F48C546C1F476700 => 220F6B51DD0CF762D6C7D2FC66BD72689100
status   90C400002100DA23D7FA0808DF0EBA6950DD9FA821B9846CFEC70AB31181EF065A515B25BE8600 => 1E
assert   apps[0].keys[0] = 00000000000000000000000000000000
