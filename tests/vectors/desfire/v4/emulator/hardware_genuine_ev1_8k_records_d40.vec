#   exchange native-apdu 90C7000000 => 9100
#   exchange native-apdu 903B00001F13000000100000E3101EAC9D1F8C7B6A701B9587552965D3BC6B0546DFBF2100 => 9100
#   exchange native-apdu 90C7000000 => 9100
#   exchange native-apdu 903B00001F13000000100000A1D67450F0E14120A3E2D45FD05AB47A1397F0FB93B4DDEB00 => 9100
#   exchange native-apdu 90C7000000 => 9100
#   exchange native-apdu 903B00001F13000000100000940C1AD8CDF8EBD95A2FB564AD350633A927434E69EA309600 => 9100
