# Two applications, the shared file pool, and the credential dirty flag.
#
# Generated from tests/test_dfc_virtual_picc_multi_app_vectors.c
# (/multi-app-file-pool-and-dirty-mutations) by recording the exchanges the
# reference engine performed, then cross-checked: all 13 response byte
# expectations asserted by that test matched the recording exactly, plus the
# application AID compared against credential state. The remaining state
# assertions of the original (dirty, num_apps, num_files, file app_index) are
# kept in place as assert steps, interleaved with clear-dirty exactly where the
# original called dfc_credential_clear_dirty().
#
# The two extra exchanges are the D40 authentication handshakes, which the
# source performs via a helper and asserts only by status. Each is pinned with
# inject-random so RndB comes from the vector rather than the engine default.

name: multi-application file pool and dirty tracking
origin: synthetic
source: tests/test_dfc_virtual_picc_multi_app_vectors.c
uid: 04707172737475
picc-key-settings-1: 0F
picc-key-settings-2: 01
picc-auth-mode: D40
picc-key-len: 8

scan
assert   credential.dirty = 0
status   90CA000005A1B2C30F0100 => 00
assert   credential.dirty = 1
assert   credential.num_apps = 1
clear-dirty
status   90CA000005A1B2C30F0100 => DE
assert   credential.dirty = 0
status   90CA000005A2B2C30F0100 => 00
assert   credential.dirty = 1
assert   credential.num_apps = 2
clear-dirty
exchange native-apdu 906A000000 => A1B2C3A2B2C39100
status   905A000003A1B2C300 => 00
status   90CD0000070400EEEE02000000 => 00
assert   credential.dirty = 1
assert   credential.num_files = 1
assert   files[0].app_index = 0
clear-dirty
status   905A000003A2B2C300 => 00
status   906F000000 => 00
status   90CD0000070400EEEE03000000 => 00
assert   credential.dirty = 1
assert   credential.num_files = 2
assert   files[1].app_index = 1
clear-dirty
exchange native-apdu 906F000000 => 049100
status   905A000003A1B2C300 => 00
exchange native-apdu 906F000000 => 049100
status   905A00000300000000 => 00
inject-random 0001020304050607
exchange native-apdu 900A0000010000 => 491E890DE9ACE93291AF
exchange native-apdu 90AF000010491E890DE9ACE932E9416AD3B58C583700 => B7D1DA7CE0DD986B9100
status   90DA000003A1B2C300 => 00
assert   credential.dirty = 1
assert   credential.num_apps = 1
assert   credential.num_files = 1
assert   apps[0].aid = C3B2A2
assert   files[0].app_index = 0
clear-dirty
inject-random 0001020304050607
exchange native-apdu 900A0000010000 => 491E890DE9ACE93291AF
exchange native-apdu 90AF000010491E890DE9ACE932E9416AD3B58C583700 => B7D1DA7CE0DD986B9100
status   90FC000000 => 00
assert   credential.dirty = 1
assert   credential.num_apps = 0
assert   credential.num_files = 0
