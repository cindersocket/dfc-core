# PROVENANCE: measured, not generated. Every response byte below was captured
# from a genuine DESFire EV1 4K over PC/SC by a PC/SC capture tool
# and is used here as an expectation for our emulator. As with the other
# hardware_genuine_ev1_4k*.vec files, this vector is the opposite of the rest
# of the corpus: the others were recorded from the reference engine, so they
# pin what we decided; this one pins what the silicon does. A mismatch here is
# either a real divergence or a difference we can justify in writing, never a
# vector to be re-recorded from our engine.
#
# Card: UID 045704EA916F80, hardware 1.0, software 1.4, storage 4K. The same
# physical card as hardware_genuine_ev1_4k.vec, formatted and provisioned with
# a synthetic structure whose every key is the all-zero test key. That is what
# makes an authenticated capture safe to commit and replayable: no key material
# enters the tree, and our engine derives the same session key from the same
# pinned nonces.
#
# RndA is the fixed constant the recorder uses; RndB is the card's, recovered
# by decrypting its first authentication frame with the all-zero test key and
# pinned here with inject-random so our engine offers the same challenge.
# What this vector is for: access rights 0x1230 exercised in the
# authenticated direction. hardware_genuine_ev1_4k_issued.vec pins the
# same rights as the card reports them and as they refuse an
# unauthenticated read; this one authenticates as each of the four keys
# in turn and records which operations the card then allows. That is the
# direct check on the access-rights nibble order: a reader that had the
# read and write nibbles the wrong way round would pass the
# GetFileSettings check and fail here.
#
# Measured refusal statuses: the write key reading is 0xAE, the read key
# writing is 0xAE.

name: genuine EV1 4K, asymmetric access rights under authentication
origin: physical-card
requires: auth-aes
uid: 045704EA916F80
picc-key-settings-1: 0F
picc-key-settings-2: 01
picc-auth-mode: D40
picc-key-len: 16

scan
# An AES application with four keys, and one file whose access rights
# name a different key for each operation: logical 0x1230, which is
# 30 12 on the wire. Read is key 1, write is key 2, read&write is key
# 3, and changing the rights is key 0.
status   90CA000005B3B2B10F8400 => 00
status   905A000003B3B2B100 => 00
status   90CD0000070400301220000000 => 00
exchange native-apdu 90F50000010400 => 000030122000009100
#
# Authenticate as key 2, the write key. The write must succeed and the
# read must not: key 2 appears in the write nibble only.
inject-random 26608AB3DE640ADA296B99F62C17B502
exchange native-apdu 90AA0000010200 => CB6A05F41A7F7AFB69440B0A2F003D5F91AF
exchange native-apdu 90AF000020ED253B73BD94A5D819EC8D189DE20EDB220D67E68ECC9EBB9D881FD58FB99ECA00 => 2421D35742BEFB03A1C9E929177C0A9E9100
exchange native-apdu 903D00000F04000000080000C0FFEE00DEADBEEF00 => B5CFDEE006AD9F6C9100
exchange native-apdu 90BD0000070400000008000000 => 91AE
#
# Authenticate as key 1, the read key. The read must succeed and
# return what key 2 wrote; the write must be refused.
status   905A000003B3B2B100 => 00
inject-random 349833E16F5F167953EA4FB0927F4055
exchange native-apdu 90AA0000010100 => 3A961C4114E69CDF8882166513518A3191AF
exchange native-apdu 90AF00002077B4C01021E04C2F7472663C574FB527E1CF91D2C1EB18A4C08B43ECEEB2247500 => AB6D94B012B40038442E2EC4EA43FA6B9100
exchange native-apdu 90BD0000070400000008000000 => C0FFEE00DEADBEEFD7B403C093C21CBA9100
exchange native-apdu 903D00000F04000000080000000000000000000000 => 91AE
#
# Authenticate as key 3, the read&write key, which the rights name for
# both operations. Both must succeed.
status   905A000003B3B2B100 => 00
inject-random A9D17DFFA863764BDD596230E871DAD1
exchange native-apdu 90AA0000010300 => 6514B923E76CCD1EAA677564D4A31F6E91AF
exchange native-apdu 90AF000020C5EA7A5802107613BDDEF7281B8B1AF36AB6D6AFFEAA9047B661EA35E19F4B3B00 => 14456545CB52EBF9C24005B1F820ABC79100
exchange native-apdu 90BD0000070400000008000000 => C0FFEE00DEADBEEF1483256E7937E74E9100
exchange native-apdu 903D00000F04000000080000C0FFEE00DEADBEEF00 => AEB28009EE954BF89100
#
# Authenticate as key 0, which the rights name only for changing them.
# Neither reading nor writing is permitted.
status   905A000003B3B2B100 => 00
inject-random 2FBC3AF0285CD38D04181DC319D4C528
exchange native-apdu 90AA0000010000 => C2BA60F7BDA373F73D83029A00DB14E291AF
exchange native-apdu 90AF000020D787E301DD2723E83DC18469ADC08F9E8403D716FFA8981D0DBFD6CBC643F94500 => AF87F4443D027C2337404C1788400B099100
exchange native-apdu 90BD0000070400000008000000 => 91AE
exchange native-apdu 903D00000F04000000080000000000000000000000 => 91AE
