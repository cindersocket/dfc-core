status   905A00000301020300 => 00
status   90CD00000901011000EEEE03000000 => 00
status   903D00000A01000000030000A1A2A300 => 00
exchange iso-apdu 00A4000C021001 => 9000
exchange iso-apdu 00B0000008 => A1A2A39000
exchange iso-apdu 00B0000204 => A39000
exchange iso-apdu 00B0000301 => 9000
