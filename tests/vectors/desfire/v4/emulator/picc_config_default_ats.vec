# A credential carrying no ATS of its own is presented with the section 1.1
# default, which is a genuine DESFire EV1's answer to RATS octet for octet.
# Readers gate on this: one access reader decides whether to speak DESFire from
# the UID, SAK and ATS alone, so a default no real card answers with makes a
# correct credential unreadable.
#
# The companion vector picc_config_user_ats.vec pins the override case, and its
# ATS differs from this one in TA(1) so that neither vector can pass by accident.

name: picc config: default activation record
case-id: picc-config-default-ats
origin: synthetic
source: recorded from the reference engine, see tests/vectors/desfire/README.md
uid: 04112233445566
picc-key-settings-1: 0F
picc-key-settings-2: 01
picc-auth-mode: D40
picc-key-len: 8

scan
assert   activation.ats           = 0565810280
assert   activation.sak           = 0x20
assert   activation.atqa          = 4403

# RATS over the wire answers the same octets.
frame-exchange E080                         => 0565810280

# The session is selected, so the engine answers I-blocks after it.
frame-exchange 0A009045000000               => 0A000F019100
