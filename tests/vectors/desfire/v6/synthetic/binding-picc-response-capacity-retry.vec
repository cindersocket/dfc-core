# Synthetic regression for hosted-binding response-capacity retries.
name: ISO reads cross the binding response-buffer boundary
case-id: binding-picc-response-capacity-retry
origin: synthetic
feature-version: 6
source: generated retained-response retry regression
issues: https://github.com/cindersocket/dfc-core/issues/107
uid: 04112233445566
picc-generation: EV3
picc-storage: 4096

scan
exchange native-apdu 90CA00000FE8E8E80FB1043812D276000085010400 => 9100
exchange native-apdu 905A000003E8E8E800 => 9100
exchange native-apdu 90CD0000090214E100EEEE2C010000 => 9100
field-off
scan
exchange iso-apdu 00A4040007D276000085010400 => 9000
exchange iso-apdu 00A4020002E11400 => 9000

# Response totals include the two-byte ISO status: 256 bytes fits the
# bindings' initial buffer, while 257 and 302 require one retained retry.
exchange iso-apdu 00B00000FE => 
assert credential.dirty = 1

exchange iso-apdu 00B00000FF => 
assert credential.dirty = 1

exchange iso-apdu 00B0000000 => 
assert credential.dirty = 1
