# Exercises the transaction rules that govern LimitedCredit limits, including
# rollback, replacement, refusal atomicity, and signed value boundaries.
name: LimitedCredit transaction semantics
case-id: limited-credit-transaction-semantics
origin: synthetic
feature-version: 6
source: tests/test_dfc_virtual_picc_value_vectors.c#/limited-credit-transaction-state
issues: https://github.com/cindersocket/dfc-core/issues/127
uid: 0476616C756531
picc-generation: EV3
picc-storage: 4096

scan
status   90CA000005A1B2C30F0100 => 00
status   905A000003A1B2C300 => 00
clear-dirty
assert credential.dirty = 0
assert emulator.secure_messaging = null

# Zero is accepted as a reset/no-op before a debit-derived limit exists.
status   90CC0000110400EEEE0000000064000000320000000100 => 00
status   901C000005040000000000 => 00
status   90C7000000 => 00
exchange native-apdu 906C0000010400 => 320000009100
assert credential.dirty = 1
clear-dirty

# Zero consumes a committed limit without changing the file value.
status   90CC0000110800EEEE0000000064000000320000000100 => 00
status   90DC000005080900000000 => 00
status   90C7000000 => 00
assert credential.dirty = 1
clear-dirty
status   901C000005080000000000 => 00
status   90C7000000 => 00
exchange native-apdu 906C0000010800 => 290000009100
status   901C000005080100000000 => BE

# A debit establishes a limit immediately within the same transaction.
status   90DC000005040600000000 => 00
status   901C000005040600000000 => 00
status   90C7000000 => 00
exchange native-apdu 906C0000010400 => 320000009100

# Exact use succeeds once. A repeat is refused without consuming value.
status   90DC000005040A00000000 => 00
status   90C7000000 => 00
exchange native-apdu 906C0000010400 => 280000009100
status   901C000005040A00000000 => 00
status   90C7000000 => 00
exchange native-apdu 906C0000010400 => 320000009100
status   901C000005040100000000 => BE
exchange native-apdu 906C0000010400 => 320000009100

# Over-limit refusal does not consume the limit. Abort restores both value and
# the previously committed limit, including after a successful use.
status   90DC000005040700000000 => 00
status   90C7000000 => 00
clear-dirty
status   90DC000005040300000000 => 00
status   90A7000000 => 00
exchange native-apdu 906C0000010400 => 2B0000009100
status   901C000005040800000000 => BE
assert credential.dirty = 0
status   901C000005040500000000 => 00
assert credential.dirty = 0
status   90A7000000 => 00
assert credential.dirty = 0
exchange native-apdu 906C0000010400 => 2B0000009100
status   901C000005040700000000 => 00
status   90C7000000 => 00
assert credential.dirty = 1
exchange native-apdu 906C0000010400 => 320000009100

# Credit preserves an unused limit. A newer committed debit replaces it.
status   90DC000005040400000000 => 00
status   90C7000000 => 00
status   900C000005040100000000 => 00
status   90C7000000 => 00
status   901C000005040400000000 => 00
status   90C7000000 => 00
exchange native-apdu 906C0000010400 => 330000009100
status   90DC000005040300000000 => 00
status   90C7000000 => 00
status   90DC000005040200000000 => 00
status   90C7000000 => 00
status   901C000005040300000000 => BE
status   901C000005040200000000 => 00
status   90C7000000 => 00
exchange native-apdu 906C0000010400 => 300000009100
clear-dirty

# Selecting away aborts the pending debit. A committed limit survives a field
# cycle and remains available when the application is selected again.
status   90DC000005040600000000 => 00
status   905A00000300000000 => 00
status   905A000003A1B2C300 => 00
assert credential.dirty = 0
status   90C7000000 => 0C
exchange native-apdu 906C0000010400 => 300000009100
status   901C000005040100000000 => BE
status   90DC000005040500000000 => 00
status   90C7000000 => 00
field-off
scan
status   905A000003A1B2C300 => 00
status   901C000005040500000000 => 00
status   90C7000000 => 00
exchange native-apdu 906C0000010400 => 300000009100
assert emulator.secure_messaging = null

# Disabled support, denied access, and the wrong file type are refused without
# creating a transaction.
status   90CC0000110500EEEE0000000064000000320000000000 => 00
status   901C000005050000000000 => 9D
status   90CC0000110700FFFF0000000064000000320000000100 => 00
status   901C000005070000000000 => 9D
status   90CD0000070900EEEE04000000 => 00
status   901C000005090000000000 => 9D
status   90C7000000 => 0C

# Arithmetic crosses the signed zero boundary without overflowing.
status   90CC0000110600EEEE00000080FFFFFF7FFFFFFF7F0100 => 00
status   90DC00000506FFFFFF7F00 => 00
status   90DC000005060100000000 => 00
status   90C7000000 => 00
exchange native-apdu 906C0000010600 => FFFFFFFF9100
status   901C00000506FFFFFF7F00 => 00
status   90C7000000 => 00
exchange native-apdu 906C0000010600 => FEFFFF7F9100
