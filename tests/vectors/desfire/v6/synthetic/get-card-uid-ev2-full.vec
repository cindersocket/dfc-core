# PROVENANCE: Synthetic regression for authenticated EV2 GetCardUID response protection.
name: EV2 GetCardUID uses Full response protection
case-id: ev2-get-card-uid-full-response
origin: synthetic
feature-version: 6
source: generated GetCardUID response-protection regression
issues: https://github.com/cindersocket/dfc-core/issues/126
requires: ev2-secure-messaging
uid: 04112233445566
picc-generation: EV3
picc-storage: 4096
picc-key-settings-1: 0F
picc-key-settings-2: 81
picc-key-len: 16
picc-auth-mode: AES
picc-ev2-card-capabilities: 00000000A55A
scan

exchange native-apdu 9051000000 => 91AE
inject-random 000102030405060708090A0B0C0D0E0F
inject-random A1B2C3D4
exchange native-apdu 9071000002000000 => 7ACA0FD9BCD6EC7C9F97466616E6A28291AF
exchange native-apdu 90AF000020358D5B59ADB65D04107676586F4734468AE4FC4E8630324D15ABDA99C0D0202C00 => 4D693FA018614D600133425883AE77E27E888514CBB6195AD99B1E6B9512EEAD9100
# Independently derived from the fixed session keys: the first 16 bytes are
# encrypted UID data and the following eight bytes authenticate the response.
exchange native-apdu 9051000008BD409934F78ABB7F00 => 1ACBD4A2CA5361E90B79841746205F5AAB64A7F1025074849100
assert session.command_counter = 0100

exchange native-apdu 905100000900D6E9B9756011F21900 => 917E
assert emulator.secure_messaging = null
exchange native-apdu 9051000000 => 91AE
field-off
