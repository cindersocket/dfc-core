# PROVENANCE: Synthetic regression for protected ChangeKeySettings in an EV1 session.
name: EV1 ChangeKeySettings requires valid full protection
case-id: ev1-change-key-settings-requires-full-protection
origin: synthetic
feature-version: 6
source: generated protected ChangeKeySettings regression
issues: https://github.com/cindersocket/dfc-core/issues/125
requires: ev1,auth-aes
uid: 045704EA916F80
picc-generation: EV1
picc-storage: 4096
picc-key-settings-1: 0F
picc-key-settings-2: 01
picc-auth-mode: D40
picc-key-len: 16
scan
exchange native-apdu 90CA000005B3B2B10F8400 => 9100
exchange native-apdu 905A000003B3B2B100 => 9100

# A valid AES-authenticated command changes the selected application's settings.
inject-random 000102030405060708090A0B0C0D0E0F
exchange native-apdu 90AA0000010000 => 7ACA0FD9BCD6EC7C9F97466616E6A28291AF
exchange native-apdu 90AF000020ECC9B00FDB4E6B30E0A7FCF1C08A892CA8F292369D4982D894F48C546C1F476700 => 220F6B51DD0CF762D6C7D2FC66BD72689100
exchange native-apdu 90540000100E3A8785EC76C1D0CECA8B4E20FC5F2200 => 67FC0BB4CE3886BC9100
assert apps[0].key_settings_1 = 0x0E

# Replaying an EV1 cryptogram is rejected and does not repeat the mutation.
exchange native-apdu 90540000100E3A8785EC76C1D0CECA8B4E20FC5F2200 => 911E
assert apps[0].key_settings_1 = 0x0E

# Plaintext, truncated, corrupted, and wrong-key ciphertext are all rejected.
