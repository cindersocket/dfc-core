# A valid EV2 full command changes the selected application's settings.
inject-random 000102030405060708090A0B0C0D0E0F
inject-random A1B2C3D4
exchange native-apdu 9071000002000000 => 7ACA0FD9BCD6EC7C9F97466616E6A28291AF
