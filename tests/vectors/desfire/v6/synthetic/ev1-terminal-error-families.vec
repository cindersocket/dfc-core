# PROVENANCE: Synthetic regression for generic EV1 terminal-error handling.
name: EV1 terminal error families return plain status and retire authentication
case-id: ev1-terminal-error-families-retire-session
origin: synthetic
feature-version: 6
source: generated command-error family regression
requires: ev1,auth-aes
uid: 045704EA916F80
picc-generation: EV1
picc-storage: 4096
picc-key-settings-1: 0F
picc-key-settings-2: 01
picc-auth-mode: D40
picc-key-len: 16
scan
exchange native-apdu 90CA000005B3B2B10F8400 => 9100
exchange native-apdu 905A000003B3B2B100 => 9100
exchange native-apdu 90CD0000070100000004000000 => 9100

# A structurally invalid command returns LENGTH_ERROR without a response CMAC.
inject-random AE2BD60FC7707E4421AAAF22A96B57D9
exchange native-apdu 90AA0000010100 => D4D5134446E75962C7B0286F9F93C42491AF
exchange native-apdu 90AF000020E63DCD42E49ADA2D8A38AFDD93A76B9131F137C175903F19529C49968B813CEA00 => 625B109FD57FE03E0FC284EFCE6318409100
assert emulator.secure_messaging = present
exchange native-apdu 90600000010000 => 917E
assert emulator.secure_messaging = null
exchange native-apdu 9045000000 => 0F849100

# A value rejected by command validation returns PARAMETER_ERROR unchanged.
inject-random AE2BD60FC7707E4421AAAF22A96B57D9
exchange native-apdu 90AA0000010100 => D4D5134446E75962C7B0286F9F93C42491AF
exchange native-apdu 90AF000020E63DCD42E49ADA2D8A38AFDD93A76B9131F137C175903F19529C49968B813CEA00 => 625B109FD57FE03E0FC284EFCE6318409100
assert emulator.secure_messaging = present
exchange native-apdu 90F50000010300 => 91F0
assert emulator.secure_messaging = null
exchange native-apdu 9045000000 => 0F849100

# A missing resource returns FILE_NOT_FOUND unchanged.
inject-random AE2BD60FC7707E4421AAAF22A96B57D9
exchange native-apdu 90AA0000010100 => D4D5134446E75962C7B0286F9F93C42491AF
exchange native-apdu 90AF000020E63DCD42E49ADA2D8A38AFDD93A76B9131F137C175903F19529C49968B813CEA00 => 625B109FD57FE03E0FC284EFCE6318409100
assert emulator.secure_messaging = present
exchange native-apdu 90BD0000071E00000001000000 => 91F0
assert emulator.secure_messaging = null
exchange native-apdu 9045000000 => 0F849100

# An authorization failure returns AUTHENTICATION_ERROR unchanged.
inject-random AE2BD60FC7707E4421AAAF22A96B57D9
exchange native-apdu 90AA0000010100 => D4D5134446E75962C7B0286F9F93C42491AF
exchange native-apdu 90AF000020E63DCD42E49ADA2D8A38AFDD93A76B9131F137C175903F19529C49968B813CEA00 => 625B109FD57FE03E0FC284EFCE6318409100
assert emulator.secure_messaging = present
exchange native-apdu 90BD0000070100000001000000 => 91AE
assert emulator.secure_messaging = null
exchange native-apdu 9045000000 => 0F849100

# An unknown opcode returns ILLEGAL_COMMAND_CODE unchanged.
inject-random AE2BD60FC7707E4421AAAF22A96B57D9
exchange native-apdu 90AA0000010100 => D4D5134446E75962C7B0286F9F93C42491AF
exchange native-apdu 90AF000020E63DCD42E49ADA2D8A38AFDD93A76B9131F137C175903F19529C49968B813CEA00 => 625B109FD57FE03E0FC284EFCE6318409100
assert emulator.secure_messaging = present
exchange native-apdu 90FF000000 => 911C
assert emulator.secure_messaging = null
exchange native-apdu 9045000000 => 0F849100

# Interrupting a response chain returns COMMAND_ABORTED unchanged.
inject-random AE2BD60FC7707E4421AAAF22A96B57D9
exchange native-apdu 90AA0000010100 => D4D5134446E75962C7B0286F9F93C42491AF
exchange native-apdu 90AF000020E63DCD42E49ADA2D8A38AFDD93A76B9131F137C175903F19529C49968B813CEA00 => 625B109FD57FE03E0FC284EFCE6318409100
assert emulator.secure_messaging = present
exchange native-apdu 9060000000 => 0401010100180591AF
assert emulator.secure_messaging = present
exchange native-apdu 9045000000 => 91CA
assert emulator.secure_messaging = null
exchange native-apdu 9045000000 => 0F849100
field-off
