# PROVENANCE: measured from a second genuine DESFire EV3 2K with Proxmark3 (random UID).
# The card presents a 4-byte random ID, so replay uses a fixed 7-byte UID; no
# frame under test depends on it. FormatPICC is permanently disabled on this card.
# Frames were built as raw wire bytes. Each section is independent: it selects the
# application and, where state matters, sets that state first. The card is nearly
# out of memory, so creation attempts answer 0E and FreeMem reports zero; those
# describe this card's fill level rather than the emulator's and are recorded in
# the comments of the sections they appear in.
name: genuine EV3 2K native and ISO bad commands and bad parameters
case-id: hardware-physical-ev3-2k-bad-commands
origin: physical-card
feature-version: 6
source: physical-card-proxmark3
requires: record-files
uid: 04112233445566
picc-generation: EV3
picc-storage: 2048
picc-key-settings-1: 0F
picc-key-settings-2: 01
picc-key-len: 16
picc-auth-mode: D40
picc-format-disabled: 1
picc-hardware-version: 04010133001605
picc-software-version: 04010103001605


# Equivalent freely provisioned replay fixture: application 123456 with ISO file
# ids, standard file 1 (16 bytes) and linear record files 2 and 3
# (four 4-byte records). Access is free, so no authentication is replayed.
scan
status 905A00000300000000 => 00
status 90CA0000071234560F2100E100 => 00
status 905A00000312345600 => 00
status 90CD00000901011000EEEE10000000 => 00
status 90C100000C02021000EEEE04000004000000 => 00
status 90C100000C03031000EEEE04000004000000 => 00
status 908D00001701000000100000A0A1A2A3A4A5A6A7A8A9AAABACADAEAF00 => 00

# N1 GetFileSettings: valid, absent, reserved range, out of range
field-off
scan
frame-exchange E080 => 0565810280
frame-exchange 02905A00000312345600 => 029100
frame-exchange 0390F50000010100 => 030000EEEE1000009100
frame-exchange 0290F50000010900 => 0291F0
frame-exchange 0390F50000011F00 => 0391F0
frame-exchange 0290F50000012000 => 02919E
frame-exchange 0390F5000001FF00 => 03919E

