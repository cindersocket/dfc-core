# A3 Directory commands inside the application: ISO ids, file ids, DF names, free memory, application ids
field-off
scan
frame-exchange E080 => 0565810280
frame-exchange 02905A00000312345600 => 029100
frame-exchange 039061000000 => 030110021003109100
frame-exchange 02906F000000 => 020102039100
frame-exchange 03906D000000 => 03919D
# The next exchange is FreeMem. The card answered 00 00 00 (no memory left) because it was
# full. The emulator reports its own pool, so the three free-memory bytes are matched
# loosely (`??`); every other byte, and every exchange after it, is as captured.
frame-exchange 02906E000000 => 02??????9100
frame-exchange 03906A000000 => 03919D

