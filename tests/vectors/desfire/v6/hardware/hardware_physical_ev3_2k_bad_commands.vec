frame-exchange 02906A0000010000 => 02917E
frame-exchange 03906E0000010000 => 03917E
frame-exchange 02906D0000010000 => 02917E

# A5 PICC level: application management without authentication (all refused or length errors)
field-off
scan
frame-exchange E080 => 0565810280
frame-exchange 02905A00000312345600 => 029100
frame-exchange 03905A00000300000000 => 039100
frame-exchange 0290DA00000365432100 => 0291AE
frame-exchange 0390DA00000312345600 => 0391AE
# The next exchange is CreateApplication on the full card. The card answered 91 0E (out of
# memory); a replay has memory, so the emulator succeeds. The status byte is matched
# loosely (`??`), which means this one exchange does NOT pin the card's answer, and the
# frames after it are exactly as captured.
frame-exchange 0290CA0000056543210F2100 => 0291??
frame-exchange 0390CA0000051234560F2100 => 0391DE
frame-exchange 0290CA00000312345600 => 02917E
frame-exchange 0390CA0000066543210F0F2100 => 03917E
frame-exchange 0290FC000000 => 02911C
frame-exchange 0390FC0000010000 => 03917E

# A6 Create file errors inside the application: duplicate number, number out of range, zero size, bad communication mode, duplicate ISO id
field-off
scan
frame-exchange E080 => 0565810280
frame-exchange 02905A00000312345600 => 029100
frame-exchange 0390CD00000901011000EEEE10000000 => 0391DE
frame-exchange 0290CD00000920091000EEEE10000000 => 02919E
frame-exchange 0390CD00000905051000EEEE00000000 => 03919E
# The next exchange is CreateStdDataFile with communication mode 02 on the full card. The
# card answered 91 0E (out of memory), before it looked at the mode. The status byte is
# matched loosely (`??`), so this exchange does NOT pin the card's answer; the frames
# after it are exactly as captured.
frame-exchange 0290CD00000905051002EEEE10000000 => 0291??
frame-exchange 0390CD00000905011000EEEE10000000 => 0391DE
frame-exchange 0290CD00000605051000EEEE00 => 02917E
frame-exchange 0390CD00000A05051000EEEE1000000000 => 03917E

