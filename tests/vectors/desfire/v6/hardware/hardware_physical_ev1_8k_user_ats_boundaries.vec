# Captured from a physical DESFire EV1 8K card over PC/SC. The PICC master
# key is the all-zero test key. Each authenticated exchange uses reader random
# A0A1A2A3A4A5A6A7 and injects the card random recovered from the RF response.
# The final exchange restores the activation bytes observed before the probe.
name: physical EV1 8K user ATS boundary behavior
case-id: hardware-physical-ev1-8k-user-ats-boundaries
origin: physical-card
source: physical-card-pcsc
requires: ev1,auth-iso
uid: 04283922216A80
picc-generation: EV1
picc-storage: 8192
picc-key-settings-1: 0F
picc-key-settings-2: 01
picc-auth-mode: ISO
picc-key-len: 16
picc-key: 00000000000000000000000000000000

scan

# Six-byte activation value already reported by this card: accepted.
exchange native-apdu 905A00000300000000 => 9100
inject-random 23E30404192490B4
exchange native-apdu 901A0000010000 => 34EC72349444E32291AF
exchange native-apdu 90AF000010EAE5FD172F9F9185471DCBC7D5CE59DC00 => 91879D0519ED26929100
