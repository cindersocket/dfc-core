# A fresh session sends one 197-byte logical wrapped APDU (Lc BF). The PC/SC
# transport must split it across ISO-DEP I-blocks because FSC is 64. It still
# succeeds with a response MAC instead of the 919D measured for native 3D/AF.
status 905A00000382F2D100 => 00
inject-random EDE63DC8CF36A6FF0A759EC4D1E3F280661096AE
exchange native-apdu 9071000002000000 => D975C9D48A21A9B9829243F536C1329C91AF
