# PROVENANCE: measured from the attached genuine DESFire EV3 2K over an
# ACR122U using PC/SC. PC/SC exposes only the logical APDU, not its individual
# ISO-DEP I-blocks. The 197-byte wrapped APDU necessarily exceeded the card's
# negotiated 64-byte frame size, so the transport segmented it below PC/SC.
name: genuine EV3 2K EV2 chained-write disable does not block ISO-DEP segmentation
case-id: hardware-physical-ev3-2k-sm-disable-ev2-iso-dep-write
origin: physical-card
feature-version: 6
source: physical-card-pcsc
replayable: false
requires: ev2-secure-messaging
uid: 044D234A281F90
picc-generation: EV3
picc-storage: 2048
picc-key-settings-1: 0F
picc-key-settings-2: 01
picc-key-len: 16
picc-ats: 7577810280
picc-hardware-version: 04010133001605
picc-software-version: 04010103001605

scan
status 90CA00000582F2D10F8200 => 00
status 905A00000382F2D100 => 00
status 90CD000007010300002C010000 => 00

# Set application option 04 clear data 00 04, disabling protected native
# StandardData writes that need 3D/AF command chaining.
inject-random 55E938C7B7E84FFB594BF1ACCB43F8677621AFC7
exchange native-apdu 9071000002000000 => 00B835F119EB444FFC9814077246EA5D91AF
exchange native-apdu 90AF000020E31510B19023F3BC67B85C2D3E8B1B4ED9A8F1EE76A0F25B51FFAE837A3E44C900 => EAA3D53E3DF6713E58B16DB7B0B74C812F25F2056529EBCD5B2A66806EDA97A09100
exchange native-apdu 905C00001904371206FB296AAEEC1219297763B951482371849BFE7C1A9700 => 0107BF4ADAD1081E9100

# The 53-byte logical APDU fits one ISO-DEP I-block. Protected alternate
# WriteData 8D succeeds, and its protected readback decrypts to 00..0F.
exchange native-apdu 908D00002F01000000100000B7E7E343E0E7B1F68F3EB87A58D69BD390557E67A43BF82266FF3662003D30CFF2E6D60148E6176200 => 05833CDC2F930A3F9100
