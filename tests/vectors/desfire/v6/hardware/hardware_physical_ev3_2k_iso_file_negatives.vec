# Wrapped native APDU length rules (genuine EV3), probed with a command whose
# answer does not depend on file state. With Lc = 0 only the bare 5-byte form,
# or the header plus a zero two-byte extended Le, reaches the command (919D
# here); every other length is 917E. With data the final Le byte is REQUIRED:
# data without Le, and data plus Le plus a trailing byte, both answer 917E.
field-off
scan
frame-exchange E080 => 0565810280
frame-exchange 02905A00000312345600 => 029100
frame-exchange 03906A000000 => 03919D
frame-exchange 02906A00000000 => 02917E
frame-exchange 03906A00000001 => 03917E
frame-exchange 02906A0000000000 => 02919D
frame-exchange 03906A0000000001 => 03917E
frame-exchange 02906A000000000000 => 02917E
frame-exchange 03905A00000312345600 => 039100
frame-exchange 02905A0000031234560000 => 02917E
frame-exchange 03905A000003123456 => 03917E

# READ RECORD mode bits and record numbering (genuine EV3, linear file). P2 bits
# 2-0 must be 100b (one record) or 101b (P1 through the last record); every other
# value, including 000b, is 6A86. Record 0 is the last written. A short Le
# truncates the sequence, and an absent record is 6985.
field-off
scan
frame-exchange E080 => 0565810280
frame-exchange 02905A00000312345600 => 029100
frame-exchange 0390EB0000010300 => 039100
frame-exchange 0290C7000000 => 029100
frame-exchange 0300A4020C021003 => 039000
frame-exchange 0200E2000004F1F2F3F4 => 029000
frame-exchange 0300E2000004A1A2A3A4 => 039000
frame-exchange 0200B2010000 => 026A86
frame-exchange 0300B2010100 => 036A86
frame-exchange 0200B2010200 => 026A86
frame-exchange 0300B2010300 => 036A86
frame-exchange 0200B2010400 => 02F1F2F3F49000
frame-exchange 0300B2010500 => 03F1F2F3F4A1A2A3A49000
frame-exchange 0200B2010600 => 026A86
frame-exchange 0300B2010700 => 036A86
frame-exchange 0200B2000400 => 02A1A2A3A49000
frame-exchange 0300B2000500 => 03A1A2A3A49000
frame-exchange 0200B2010402 => 02F1F29000
frame-exchange 0300B2010500 => 03F1F2F3F4A1A2A3A49000
frame-exchange 0200B2010502 => 02F1F29000
frame-exchange 0300B2020500 => 03A1A2A3A49000
frame-exchange 0200B2030400 => 026985
frame-exchange 0300B2030500 => 036985

# The wrapped Le byte must be 00; any other value is 917E.
field-off
scan
frame-exchange E080 => 0565810280
frame-exchange 02905A00000312345600 => 029100
frame-exchange 03905A00000312345601 => 03917E
frame-exchange 02905A000003123456FF => 02917E
frame-exchange 03905A00000312345600 => 039100
frame-exchange 02906A0000010000 => 02917E
