# PROVENANCE: measured from a second genuine DESFire EV3 2K with Proxmark3 (random UID).
# Frames were built as raw wire bytes, not with the client's commands.
# A short file identifier selects its file for later commands, including for
# APPEND RECORD, and selection happens before validation: a failed SFI command
# still moves it. Errors for out-of-range reads, reserved or absent ids, wrong
# lengths, and full record files are recorded as the silicon returned them.
name: genuine EV3 2K ISO file access negative and weird states
case-id: hardware-physical-ev3-2k-iso-file-negatives
origin: physical-card
feature-version: 6
source: physical-card-proxmark3
requires: record-files
uid: 04112233445566
picc-generation: EV3
picc-storage: 2048
picc-key-settings-1: 0F
picc-key-settings-2: 01
picc-key-len: 16
picc-auth-mode: D40
picc-hardware-version: 04010133001605
picc-software-version: 04010103001605


# Equivalent freely provisioned replay fixture: application 123456 with ISO file
# ids, standard files 1 and 4 (16 bytes) and linear record files 2 and 3
# (four 4-byte records). Access is free, so no authentication is replayed.
scan
status 905A00000300000000 => 00
status 90CA0000071234560F2100E100 => 00
status 905A00000312345600 => 00
status 90CD00000901011000EEEE10000000 => 00
status 90C100000C02021000EEEE04000004000000 => 00
status 90C100000C03031000EEEE04000004000000 => 00
status 90CD00000904041000EEEE10000000 => 00
status 908D00001701000000100000A0A1A2A3A4A5A6A7A8A9AAABACADAEAF00 => 00
status 908D000017040000001000004444444444444444444444444444444400 => 00

# wrapped: unknown INS, wrong CLA 91, unknown ISO INS, short A4
field-off
scan
frame-exchange E080 => 0565810280
frame-exchange 02905A00000312345600 => 029100
frame-exchange 0390FE000000 => 03911C
frame-exchange 02916F000000 => 021C
frame-exchange 0300FF000000 => 036D00
frame-exchange 0200A40400 => 026A87

# wrapped length mismatches: Lc=5 no data / no Le / trailing byte
field-off
scan
frame-exchange E080 => 0565810280
frame-exchange 02905A00000312345600 => 029100
frame-exchange 03906F000005 => 03917E
frame-exchange 02906F0000 => 02917E
frame-exchange 03906F00000000 => 03917E
frame-exchange 0200 => 026700

